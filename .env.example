# =============================================================================
# CS2 饰品价格波动监控系统 - 环境变量配置
# =============================================================================
# 请将本文件复制为 .env 并填写真实的配置值
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# 多用户认证与加密（必填）
# -----------------------------------------------------------------------------
# 加密用户 SteamDT API Key 的主密钥（Fernet 32 字节 base64）
# 生成命令：
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key.decode)"
# ⚠️ 一旦设定不可更改，否则所有已加密的用户 API Key 将无法解密！
MASTER_ENCRYPTION_KEY=

# JWT 签名密钥（强随机字符串）
# 生成命令：
# uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# Admin 初始密码（仅首次启动生效，登录后强制改密）
# 部署后请立即在 .env 中设置并妥善保管，首次登录后此变量将失效
ADMIN_INITIAL_PASSWORD=

# -----------------------------------------------------------------------------
# SteamDT API（可选，系统级）
# -----------------------------------------------------------------------------
# 多用户模式下每个用户在 Web 端填写自己的 API Key（加密存 DB）。
# 此处的全局 Key 是可选的，仅用于系统级任务（如 items_base 全市场缓存同步），
# 避免占用某个用户的限流额度。可留空。
STEAMDT_API_KEY=
STEAMDT_API_BASE_URL=https://open.steamdt.com

# -----------------------------------------------------------------------------
# 监控调度配置
# -----------------------------------------------------------------------------
CHECK_INTERVAL_MINUTES=30
DEFAULT_THRESHOLD_PERCENT=5.0
ALERT_COOLDOWN_HOURS=4
TIMEZONE=Asia/Shanghai

# -----------------------------------------------------------------------------
# 捡漏雷达（BARGAIN_SCANNER）
# -----------------------------------------------------------------------------
# 是否启用捡漏雷达后台扫描任务
BARGAIN_SCANNER_ENABLED=false

# 扫描周期（分钟）。SteamDT batch price 接口限流 1 次/分钟，每批 100 个，
# 全市场 ~3-4 万饰品 → 单轮约 6-7 小时。建议至少 6 小时（=360 分钟）
BARGAIN_SCAN_INTERVAL_MINUTES=360

# SteamDT 阈值：buff_price / steam_price < 此值才视为候选（命中初筛）
BARGAIN_ACCEPT_STEAMDT_THRESHOLD=0.65

# Steam 阈值：buff_price / (steam_price / (1 + fee_rate)) < 此值才视为命中
BARGAIN_ACCEPT_STEAM_THRESHOLD=0.8

# Steam 市场手续费率（卖家承担，默认 15%）
BARGAIN_STEAM_FEE_RATE=0.15

# 价格过滤（单位：分。500 = 5 元，30000 = 300 元）
BARGAIN_MIN_PRICE=500
BARGAIN_MAX_PRICE=30000

# 24h 最小成交量过滤
BARGAIN_MIN_VOLUME=0

# 命中后是否通过通知渠道推送
BARGAIN_NOTIFY_ENABLED=true

# items_base（全市场名单）本地缓存有效期（小时）
BARGAIN_BASE_CACHE_HOURS=24

# Steam 社区市场请求间隔（秒，IP 限流防护）
BARGAIN_STEAM_REQUEST_INTERVAL=4

# -----------------------------------------------------------------------------
# Web 服务
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080

# -----------------------------------------------------------------------------
# 通知渠道（至少配置一种）
# -----------------------------------------------------------------------------
# 默认通知渠道: wecom / telegram / serverchan
NOTIFY_CHANNEL=wecom

# 企业微信机器人 Webhook
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_PROXY=

# Server 酱配置
SERVERCHAN_SENDKEY=your_serverchan_sendkey
