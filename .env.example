# =============================================================================
# CS2 饰品价格波动监控系统 - 环境变量配置
# =============================================================================
# 请将本文件复制为 .env 并填写真实的配置值
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# 多用户认证与加密（必填）
# -----------------------------------------------------------------------------
# Fernet 主密钥（32 字节 base64），用于对称加密用户 SteamDT API Key.
# 生成：
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 一旦设定不可更改，否则所有已加密的用户 API Key 都无法解密！
MASTER_ENCRYPTION_KEY=

# JWT 签名密钥（强随机字符串，HS256）
# 生成：
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# Admin 初始密码（仅首次启动生效，登录后强制改密）
# 改密后此变量自动失效，可保留也可清空；忘密时用 scripts/manage_users.py 重置.
ADMIN_INITIAL_PASSWORD=

# -----------------------------------------------------------------------------
# SteamDT API（可选，系统级）
# -----------------------------------------------------------------------------
# 多用户模式下每个用户在 Web 端填写自己的 API Key（加密存 DB），由调度器循环
# 时按用户解密、各自跑各自的采集.
# 此处的全局 Key 仅用于系统级任务（如 items 全市场名单同步、启动时基准价重算），
# 避免占用某个用户的限流额度.可留空，无则借任一已配置 Key 的用户来跑系统级任务.
STEAMDT_API_KEY=
STEAMDT_API_BASE_URL=https://open.steamdt.com

REQUEST_TIMEOUT=30
REQUEST_RETRY=3

# -----------------------------------------------------------------------------
# 监控调度配置
# -----------------------------------------------------------------------------
CHECK_INTERVAL_MINUTES=30
DEFAULT_THRESHOLD_PERCENT=5.0
ALERT_COOLDOWN_HOURS=4
TIMEZONE=Asia/Shanghai

# -----------------------------------------------------------------------------
# 跨市差价（低买高卖扫描）
# -----------------------------------------------------------------------------
# 扫描参数（启用 / 利润率 / 平台白名单 / 冷却 / 通知）按每用户独立配置，
# 通过 Web 仪表盘的「跨市差价」页面或 /api/bargain/config 设置，写入 DB，
# 不需要在 .env 配置.调度器每分钟 tick，按每用户 interval_minutes 自节流.

# -----------------------------------------------------------------------------
# Web 服务
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080

# -----------------------------------------------------------------------------
# 通知渠道（至少配置一种；多渠道按用户全局共享）
# -----------------------------------------------------------------------------
# 默认通知渠道: wecom / telegram / serverchan
NOTIFY_CHANNEL=wecom

# 企业微信机器人 Webhook
WECOM_WEBHOOK_URL=

# Telegram Bot（中国大陆需配置 TELEGRAM_PROXY=http://127.0.0.1:7890）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=

# Server 酱 SendKey
SERVERCHAN_SENDKEY=
